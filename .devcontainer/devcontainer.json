{
    "name": "Claude Code Sandbox",
    "build": { "dockerfile": "Dockerfile" },
    "remoteUser": "developer",
    "updateRemoteUserUID": true,
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "runArgs": [
        "--userns=keep-id",
        "--security-opt=label=disable"
    ],
    "containerEnv": {
        "TZ": "America/Los_Angeles",
        "TERM": "xterm-256color"
    },
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/developer/.claude,type=bind,readonly=false",
        "source=${localEnv:HOME}/.claude.json,target=/home/developer/.claude.json,type=bind,readonly=false",
        "source=${localEnv:HOME}/.gemini,target=/home/developer/.gemini,type=bind,readonly=false",
        "source=${localEnv:HOME}/.local/bin/agy,target=/home/developer/.local/bin/agy,type=bind"
    ]
}
